#!/bin/sh

# This file runs when a DM logs you into a graphical session.
# If you use startx/xinit, this file is sourced from ~/.xinitrc as well.

# Hand the display to the systemd user manager and the D-Bus activation
# environment. Both are already running by the time X starts here (xinitrc
# execs i3 from a tty login), so without this any GUI service they activate
# dies with "cannot open display". That is what broke saving downloads in
# Chrome: it asks xdg-desktop-portal for the file chooser, and the GTK backend
# behind it could never start, so no dialog appeared at all.
systemctl --user import-environment DISPLAY XAUTHORITY
command -v dbus-update-activation-environment >/dev/null &&
	dbus-update-activation-environment --systemd DISPLAY XAUTHORITY

mpd &			# music player daemon; you may prefer it as a user service
remapd &		# applies `remaps` now, and again whenever a USB input device appears
setbg &			# set the background with the `setbg` script

# Load colours, fonts and the st alpha value. This is active, not optional:
# without it *.font and *.alpha are unset and st falls back to config.h.
xrdb ${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources

# Optional pywal colours. Note XDG_CACHE_HOME, not XDG_CONFIG_HOME: the cache
# is where wal writes. Uncomment to use.
#xrdb -merge ${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors.xresources &

picom &			# compositor: transparency, shadows, the opacity rules
dunst &			# notifications
xset r rate 300 50 &	# faster key repeat
unclutter &		# hide the mouse when idle
