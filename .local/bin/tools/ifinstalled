#!/usr/bin/env sh

# If a required command is missing, notify and return non-zero. Accepts several
# names and checks all of them, so callers can write:
#	ifinstalled ffmpeg sox || exit 1
# Falls back to the package database, since some deps (fonts, libraries) are
# installed without providing a command of the same name.

for x in "$@"; do
	command -v "$x" >/dev/null 2>&1 && continue
	pacman -Qq "$x" >/dev/null 2>&1 && continue
	notify-send "📦 $x" "must be installed for this function."
	exit 1
done
