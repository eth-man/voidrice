#!/usr/bin/env bash

# Self-check for this dotfiles setup. Finds the classes of breakage that are
# otherwise silent: a script that is not executable is simply unreachable, a
# module that errors just shows an empty block, a glyph the font lacks is
# quietly drawn by a different font, and a config that references a command
# that was never installed fails only when you press the key.
#
#   voidrice-doctor          run every check
#   voidrice-doctor -q       only report problems
#
# Exit status is the number of failures, so it is usable in CI or a hook.

REPO="${DOTREPO:-$HOME/voidrice-repo}"
BIN="$REPO/.local/bin"
quiet=0; [ "$1" = "-q" ] && quiet=1
fails=0; warns=0

red=$'\033[31m'; yel=$'\033[33m'; grn=$'\033[32m'; dim=$'\033[2m'; off=$'\033[0m'
sec()  { [ $quiet -eq 1 ] || printf '\n%s== %s ==%s\n' "$dim" "$1" "$off" ;}
ok()   { [ $quiet -eq 1 ] || printf '  %sok%s   %s\n' "$grn" "$off" "$1" ;}
warn() { printf '  %swarn%s %s\n' "$yel" "$off" "$1"; warns=$((warns+1)) ;}
fail() { printf '  %sFAIL%s %s\n' "$red" "$off" "$1"; fails=$((fails+1)) ;}

[ -d "$REPO/.git" ] || { echo "no repo at $REPO"; exit 1 ;}

# ---------------------------------------------------------------- scripts ---
sec "scripts"
n=0; bad=0
while IFS= read -r f; do
	p="$REPO/$f"; [ -f "$p" ] || continue
	case "$f" in *.md|*.kmap|*.png|*.mom) continue;; esac
	head -c2 "$p" | grep -q '#!' || continue
	n=$((n+1))
	# Only files under .local/bin are executed; .bashrc, aliasrc and .xinitrc
	# are sourced and legitimately have no executable bit.
	case "$f" in .local/bin/*)
		[ -x "$p" ] || { fail "not executable, so unreachable on \$PATH: $f"; bad=1; } ;;
	esac
	shebang=$(head -1 "$p")
	case "$shebang" in
		*bash) bash -n "$p" 2>/dev/null || { fail "bash syntax error: $f"; bad=1; } ;;
		*sh)   sh -n "$p" 2>/dev/null   || { fail "sh syntax error: $f"; bad=1; }
		       # bash-only constructs under a POSIX shebang: works only because
		       # /bin/sh is bash here, breaks anywhere sh is dash.
		       if grep -qP '\[\[|(?<!\$)\(\(|\bRANDOM\b|EPOCHSECONDS|\$\{[A-Za-z_]+\^\^|(?<!\$)<\(' "$p"; then
		           warn "bashism under '$shebang': $f"
		       fi ;;
	esac
done < <(cd "$REPO" && git ls-files)
[ $bad -eq 0 ] && ok "$n scripts: shebang, executable bit and syntax all good"

# -------------------------------------------------------------- i3blocks ---
sec "i3blocks"
cfg="$REPO/.config/i3blocks/config"
if [ -f "$cfg" ]; then
	dup=$(grep '^\[' "$cfg" | sort | uniq -d)
	[ -n "$dup" ] && fail "duplicate block(s) -- these render twice: $(echo $dup)" || ok "no duplicate blocks"
	dups=$(grep '^signal=' "$cfg" | sort | uniq -d)
	[ -n "$dups" ] && fail "two blocks share a refresh signal: $(echo $dups)" || ok "no signal collisions"
	# SIGRTMIN+30 is SIGRTMAX on Linux; anything higher cannot be sent at all.
	high=$(awk -F= '/^signal=/ && $2+0 > 30 {print $2}' "$cfg")
	[ -n "$high" ] && fail "signal past RTMIN+30 can never be sent: $(echo $high)" || ok "every signal is sendable"
	miss=0
	for b in $(grep '^\[' "$cfg" | tr -d '[]'); do
		cmd=$(awk -v b="[$b]" '$0==b{f=1;next} /^\[/{f=0} f&&/^command=/{sub(/^command=/,"");print;exit}' "$cfg")
		[ -n "$cmd" ] && continue          # explicit command= overrides the name
		[ -f "$BIN/statusbar/$b" ] || { fail "block [$b] has no script at statusbar/$b"; miss=1; }
	done
	[ $miss -eq 0 ] && ok "every block resolves to a script"
fi

# --------------------------------------------------------------- i3 config ---
sec "i3"
i3cfg="$REPO/.config/i3/config"
if [ -f "$i3cfg" ]; then
	i3 -C -c "$i3cfg" >/dev/null 2>&1 && ok "config parses" || fail "i3 -C rejects the config"
	dup=$(grep -oP '^bindsym \K\S+' "$i3cfg" | sort | uniq -d)
	[ -n "$dup" ] && fail "duplicate binding(s), the later one wins: $(echo $dup)" || ok "no duplicate bindings"
	PATH="$BIN/statusbar:$BIN/tools:$BIN/i3cmds:$BIN/cron:$PATH"
	grep -v '^\s*#' "$i3cfg" | grep -ohE 'exec (--no-startup-id )?[a-z0-9._-]+' |
	awk '{print $NF}' | sort -u | while read -r c; do
		[ "$c" = "--no-startup-id" ] && continue
		command -v "$c" >/dev/null 2>&1 || echo "$c"
	done > /tmp/vd-missing.$$
	if [ -s /tmp/vd-missing.$$ ]; then
		while read -r c; do
			if [ -f "$BIN/i3cmds/$c" ] || [ -f "$BIN/tools/$c" ]; then
				fail "bound to $c, which is in the repo but not executable"
			else
				warn "bound to '$c', which is not installed"
			fi
		done < /tmp/vd-missing.$$
	else ok "every bound command resolves"; fi
	rm -f /tmp/vd-missing.$$
fi

# ------------------------------------------------------------------ fonts ---
sec "fonts"
if command -v fc-list >/dev/null; then
	# Every icon on the bar comes from suckless icons (eth-man/ablocks,
	# icons/icons.py): one grid, one stroke weight, drawn for this bar. A
	# Nerd Font glyph, in the BMP private-use area or plane 15, is from
	# another family and will not match.
	nonsl=$(python3 - "$BIN"/statusbar/* <<-'EOF' 2>/dev/null
		import sys, os
		for f in sys.argv[1:]:
		    try: t = open(f, encoding="utf-8", errors="replace").read()
		    except OSError: continue
		    if any(0xE000 <= ord(c) <= 0xFD46 or 0xF0000 <= ord(c) <= 0xFFFFD for c in t):
		        print(os.path.basename(f))
		EOF
	)
	[ -n "$nonsl" ] && warn "icons from outside suckless icons, so they will not match the rest: $(echo $nonsl)" \
	                || ok "every status bar icon is from suckless icons"
	if fc-list ":charset=100000" family 2>/dev/null | grep -q "suckless icons"; then
		ok "the suckless icons font is installed"
	else
		fail "suckless icons font not installed, so every bar icon is a missing-glyph box (make install in ablocks)"
	fi
	# And one spacing: icon, one space, value. Blocks that each chose their
	# own (none, one, a trailing space) read as an uneven bar.
	jammed=$(python3 - "$BIN"/statusbar/* <<-'EOF' 2>/dev/null
		import sys, os, re
		pat = re.compile("[\U00100000-\U0010FFFD][$%A-Za-z0-9]")
		for f in sys.argv[1:]:
		    try: lines = open(f, encoding="utf-8", errors="replace").readlines()
		    except OSError: continue
		    for n, l in enumerate(lines, 1):
		        if pat.search(l): print("%s:%d" % (os.path.basename(f), n))
		EOF
	)
	[ -n "$jammed" ] && warn "icon with no space before its value: $(echo $jammed)" \
	                 || ok "every icon is followed by a space"
fi

# ------------------------------------------------------------------- paths ---
sec "paths referenced by .profile"
prof="$REPO/.profile"
if [ -f "$prof" ]; then
	miss=0
	while IFS= read -r line; do
		val=$(echo "$line" | sed 's/.*="//; s/"$//')
		case "$val" in *'$'*) val=$(eval echo "$val");; esac
		case "$val" in /*|"$HOME"*) [ -e "$val" ] || { warn "$(echo "$line" | grep -oP '^export \K[A-Z_]+') points at a missing path: $val"; miss=1; };; esac
	done < <(grep -E '^export (INPUTRC|WGETRC|SUDO_ASKPASS|GTK2_RC_FILES|NOTMUCH_CONFIG)=' "$prof")
	[ $miss -eq 0 ] && ok "every path exported by .profile exists"
fi

# ------------------------------------------------------------------ dotsync ---
sec "sync"
if command -v dotsync >/dev/null 2>&1 || [ -x "$BIN/tools/dotsync" ]; then
	drift=$("$BIN/tools/dotsync" status 2>/dev/null | grep -v 'in sync' | grep -c .)
	[ "$drift" -gt 0 ] && warn "$drift tracked file(s) differ between \$HOME and the repo (dotsync status)" \
	                   || ok "\$HOME and the repo are in sync"
fi
[ -d "$HOME/.git" ] && fail "\$HOME is a git work tree again -- that is what dotsync exists to avoid"

# ------------------------------------------------------------------ summary ---
printf '\n  %d failure(s), %d warning(s)\n' "$fails" "$warns"
exit "$fails"
