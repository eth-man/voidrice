#!/usr/bin/env sh

# Apply ~/.config/theme/palette to everything that cannot source it as sh.
# Writes two files, then reloads what reads them:
#
#   ~/.config/x11/colors                 xresources: st, dmenu, and i3,
#                                        which reads it with set_from_resource
#   ~/.config/dunst/dunstrc.d/palette.conf   dunst's colours
#
#   retheme            write both and reload X resources, i3, dunst and the bar
#   retheme DIR        write both under DIR instead, e.g. the repo; no reload
#   retheme -c [DIR]   only check that the files under DIR (default $HOME)
#                      match the palette; exit 1 and show the diff if not
#
# Both files are generated: edit the palette, not them.

check=0
[ "$1" = "-c" ] && { check=1; shift ;}
root="${1:-$HOME}"

palette="$root/.config/theme/palette"
[ -r "$palette" ] || { echo "retheme: no palette at $palette" >&2; exit 1 ;}
. "$palette"

xcolors() {
	echo "! Generated by retheme from ~/.config/theme/palette. Do not edit."
	echo
	echo "! st"
	printf '*.foreground:\t%s\n*.background:\t%s\n*.cursorColor:\t%s\n' \
		"$TERM_FG" "$C_PANEL" "$TERM_FG"
	i=0
	for c in $TERM_COLORS; do
		printf '*.color%s:\t%s\n' "$i" "$c"
		i=$((i+1))
	done
	echo
	echo "! dmenu: color0 is the background, color4 the text, swapped for"
	echo "! the selected line"
	printf 'dmenu.color0:\t%s\ndmenu.color4:\t%s\n' "$C_PANEL" "$C_NORM"
	echo
	echo "! i3, through set_from_resource"
	for v in NORM BRIGHT DIM ALERT PANEL TILE EDGE; do
		eval "c=\$C_$v"
		printf 'i3wm.%s:\t%s\n' "$(echo "$v" | tr 'A-Z' 'a-z')" "$c"
	done
	printf 'i3wm.strip:\t%s%s\n' "$C_STRIP" "$BAR_ALPHA"
}

dunstcolors() {
	cat <<-EOF
	# Generated by retheme from ~/.config/theme/palette. Do not edit.
	# Read after dunstrc, so these override its settings.

	[global]
	    frame_color = "$C_TILE"

	[urgency_low]
	    background = "$C_PANEL"
	    foreground = "$C_DIM"

	[urgency_normal]
	    background = "$C_PANEL"
	    foreground = "$C_NORM"

	[urgency_critical]
	    background = "$C_PANEL"
	    foreground = "$C_NORM"
	    frame_color = "$C_ALERT"
	EOF
}

xfile="$root/.config/x11/colors"
dfile="$root/.config/dunst/dunstrc.d/palette.conf"

if [ $check -eq 1 ]; then
	bad=0
	xcolors | diff -u "$xfile" - || bad=1
	dunstcolors | diff -u "$dfile" - || bad=1
	exit $bad
fi

mkdir -p "${dfile%/*}"
xcolors > "$xfile"
dunstcolors > "$dfile"

# Writing into another tree, such as the repo, changes nothing live.
[ "$root" = "$HOME" ] || exit 0

# Reload what reads them, each only if it is running. st and dmenu read X
# resources when they start, so open terminals keep their old colours.
[ -n "$DISPLAY" ] && xrdb "$root/.config/x11/xresources"
pgrep -x i3 >/dev/null && i3-msg -q reload
if pgrep -x dunst >/dev/null; then
	pkill -x dunst
	setsid -f dunst >/dev/null 2>&1
fi
sigbar
