#!/usr/bin/env sh
# Shared palette for i3blocks modules. Sourced, not executed:
#
#   . "$HOME/.local/bin/statusbar/sb-theme"
#   sb "$C_WARN" "􀀩 3"
#
# The colours themselves ($C_NORM, $C_DIM, $C_ALERT, ...) live in
# ~/.config/theme/palette (a link to the theme in use, switched with
# `retheme NAME`), which the rest of the desktop is themed from too,
# so the bar, the windows, the terminal and the notifications stay one design.

. "${XDG_CONFIG_HOME:-$HOME/.config}/theme/palette"

# sb COLOR TEXT -- emit one pango-marked status line.
sb() { printf "<span color='%s'>%s</span>\n" "$1" "$2" ;}
