#!/usr/bin/env sh
. "$HOME/.local/bin/statusbar/sb-theme"

OPENVPN_CONNECTION=$(pgrep -a 'openvpn$' | head -n 1 | awk '{print $NF}' |
	sed 's|/etc/openvpn/client/||g; s/\.conf//g')

if [ -n "$OPENVPN_CONNECTION" ]; then
	color="$C_OK"; icon="󰦝"
	information="- Config:   $OPENVPN_CONNECTION
- Server:   $(awk '$1 == "remote"{print $2}' "$OPENVPN_CONNECTION" 2>/dev/null)
- Port:     $(awk '$1 == "remote"{print $3}' "$OPENVPN_CONNECTION" 2>/dev/null)
- Protocol: $(awk '$1 == "proto"{print $2}' "$OPENVPN_CONNECTION" 2>/dev/null)
- Cipher:   $(awk '$1 == "cipher"{print $2}' "$OPENVPN_CONNECTION" 2>/dev/null)
- Auth:     $(awk '$1 == "auth"{print $2}' "$OPENVPN_CONNECTION" 2>/dev/null)"
else
	color="$C_DIM"; icon="󰦞"
	information="Disconnected"
fi

case $BLOCK_BUTTON in
	1) notify-send "󰦝 VPN status" "$information" ;;
	3) notify-send "󰦝 VPN module" "\- 󰦝 connected, 󰦞 disconnected.
- Left click shows connection details." ;;
esac

sb "$color" "$icon"
