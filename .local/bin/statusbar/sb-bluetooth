#!/usr/bin/env sh
# make sure you have : bluez and bluez-utils package

[[ $(bluetoothctl show | grep "Powered: yes")  ]] && icon="<span color='#076678'></span>" || icon="<span color='#969993'></span>"

if [[ $(bluetoothctl show | grep "Discovering: yes")  ]]; then
	[ $((1 + $RANDOM % 2)) = 1 ] && icon="<span color='#83a598'></span>" ||  icon="<span color='#458588'></span>"
fi


 printf "%s\n" "$icon"

case $BLOCK_BUTTON in
	1) dmenu-bluetooth ;;
	2) tg-float setsid "$TERMINAL" -e bluetoothctl>/dev/null & exit ;;
	3) notify-send " Bluetooth module " "\-R-Click to manage with dmenu.
- M-Click to launch blutoothctl cli.
- L-Click to show menu.
- ." ;;
esac
