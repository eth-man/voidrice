#!/usr/bin/env sh
# Requires bluez and bluez-utils.

. "$HOME/.local/bin/statusbar/sb-theme"

case $BLOCK_BUTTON in
	1) dmenu-bluetooth ;;
	2) setsid -f "$TERMINAL" -e bluetoothctl >/dev/null 2>&1 ;;
	3) notify-send "󰂯 Bluetooth module" "\- 󰂯 powered, 󰂲 off, 󰂰 discovering.
- Left click manages devices with dmenu.
- Middle click opens bluetoothctl." ;;
esac

show="$(bluetoothctl show 2>/dev/null)"

case "$show" in
	*"Discovering: yes"*) sb "$C_INFO" "󰂰" ;;
	*"Powered: yes"*)     sb "$C_NORM" "󰂯" ;;
	*)                    sb "$C_DIM"  "󰂲" ;;
esac
