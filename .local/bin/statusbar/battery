#!/usr/bin/env sh

battery_name="$1"

. "$HOME/.local/bin/statusbar/sb-theme"
# what this block remembers between runs, out of the way of $HOME
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sb-battery"
mkdir -p "$state_dir"
# present: the backlight was dimmed this discharge, so leave it be
dimmed_flag="$state_dir/dimmed"
charging_state_file="$state_dir/status"
# present: the icon alone, the percentage only while it is red
nopercent="$HOME/.local/share/sb-battery.nopercent"

cat_path=$(command -v cat)

if [ ! -d /sys/class/power_supply/"$battery_name" ]; then
    echo "Battery '$battery_name' not found!" >&2
    exit 1
fi

case $BLOCK_BUTTON in
	2) if [ -e "$nopercent" ]; then rm -f "$nopercent"; else : > "$nopercent"; fi ;;
	3) pgrep -x dunst >/dev/null && notify-send "􀀊 Battery module" "􀀀 empty  􀀂 low  􀀅 half  􀀇 high  􀀊 full  􀀋 charging
- Red at 20% or less while discharging, with a fill-up animation under ablocks.
- 􀀽 at 10% or less: critical, blinking until the charger goes in.
- At 20% the screen dims to 30%, once: brighten it again and it stays.
- Middle click hides or shows the percentage; hidden, it still shows while red." ;;
esac

capacity=$(cat /sys/class/power_supply/"$battery_name"/capacity) || exit
status=$(cat /sys/class/power_supply/"$battery_name"/status)

prev_status="$("$cat_path" "$charging_state_file" 2>/dev/null)"


# Calm by default, red only while discharging at or below $alert_capacity,
# the point where the lowbat animation starts too. On the charger a low
# percentage is being fixed, so it is not an alert state.
alert_capacity=20
warn_capacity=10 # critical: solid battery with "!", blinking, sticky warning
color="$C_NORM"
if [ "$capacity" -le "$alert_capacity" ] && [ "$status" = "Discharging" ]; then
  color="$C_ALERT"
fi


# Dim the backlight to $dim_brightness when the charge drops below
# $alert_capacity, once per discharge: turn it back up and it is left alone
# until the charger has been in. Never brightens a screen already dimmer.
dim_brightness=30
if [ "$status" = "Discharging" ] && [ "$capacity" -lt "$alert_capacity" ]; then
    if [ ! -e "$dimmed_flag" ] && command -v xbacklight >/dev/null; then
        current="$(xbacklight -get 2>/dev/null)"
        if [ -n "$current" ] && [ "${current%.*}" -gt "$dim_brightness" ]; then
            xbacklight -set "$dim_brightness" 2>/dev/null && sigbar 13
        fi
        : > "$dimmed_flag"
    fi
elif [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
    rm -f "$dimmed_flag"
fi

# suckless icons, like the rest of the bar: one per 10% of charge, and on
# the charger the battery with a bolt, the level being in the text.
pick() { n=$1; shift; shift "$n"; printf %s "$1" ;}
level=$(( capacity / 10 )); [ "$level" -gt 10 ] && level=10
if [ "$status" = "Charging" ]; then
    icon="􀀋"
else
    icon="$(pick "$level" 􀀀 􀀁 􀀂 􀀃 􀀄 􀀅 􀀆 􀀇 􀀈 􀀉 􀀊)"
fi
# Critical: the same battery, solid, with a "!" cut out of it. At bar
# size an outlined "!" inside the battery is two pixels; this one reads.
if [ "$status" = "Discharging" ] && [ "$capacity" -le "$warn_capacity" ]; then
    icon="􀀽"
fi


[ "$status" = "Full" ] && icon="􀀊"

# --- Low battery: persistent warning, then unattended suspend --------------
# Mirrors the Windows critical-battery behaviour: a warning that stays on
# screen from $warn_capacity down, and an automatic suspend at
# $suspend_capacity so the machine sleeps instead of dying mid-write.
suspend_capacity=5
warn_flag="$state_dir/warned"
suspend_stamp="$state_dir/suspended"
suspend_cooldown=300 # seconds; stops a wake/suspend loop if left unplugged

if [ "$status" = "Discharging" ] && [ "$capacity" -le "$warn_capacity" ]; then
    # urgency_critical sets timeout=0 in dunstrc, so this never expires on its
    # own. The stack tag makes each 5s run replace the previous notification
    # rather than stack a new one - and re-raises it if it was dismissed,
    # which is what keeps the warning on screen until the charger goes in.
    pgrep -x dunst >/dev/null && notify-send -u critical \
        -h string:x-dunst-stack-tag:battery-critical \
        "􀀽 Battery critically low: $capacity%" \
        "Connect the charger.
The system suspends automatically at $suspend_capacity%." >/dev/null 2>&1
    : > "$warn_flag"
elif [ -f "$warn_flag" ]; then
    # Recovered. Replace the sticky warning through the same stack tag with a
    # short-lived one, which is the only way to retire it without
    # dunstctl close-all taking unrelated notifications with it.
    pgrep -x dunst >/dev/null && notify-send -u low -t 4000 \
        -h string:x-dunst-stack-tag:battery-critical \
        "􀀋 Battery OK: $capacity%" "Charger connected." >/dev/null 2>&1
    rm -f "$warn_flag"
fi

if [ "$status" = "Discharging" ] && [ "$capacity" -le "$suspend_capacity" ]; then
    last_suspend="$("$cat_path" "$suspend_stamp" 2>/dev/null)"
    : "${last_suspend:=0}"
    if [ "$(( $(date +%s) - last_suspend ))" -ge "$suspend_cooldown" ]; then
        date +%s > "$suspend_stamp"
        pgrep -x dunst >/dev/null && notify-send -u critical \
            -h string:x-dunst-stack-tag:battery-critical \
            "􀀽 Suspending in 10s" \
            "Battery at $capacity%. Connect the charger to cancel." >/dev/null 2>&1
        # Detached so the bar is not blocked for the grace period, and the
        # charge is re-read at the end of it so plugging in actually cancels.
        setsid sh -c "sleep 10
            [ \"\$(cat /sys/class/power_supply/$battery_name/status)\" = Discharging ] || exit 0
            sync
            systemctl suspend" >/dev/null 2>&1 &
    fi
else
    # On the charger or recovered: re-arm for the next discharge.
    rm -f "$suspend_stamp"
fi

echo "$status" > "$charging_state_file"

if [ -e "$nopercent" ] && [ "$color" != "$C_ALERT" ]; then
    printf "<span color='%s'>%s</span>\n" "$color" "$icon"
else
    printf "<span color='%s'>%s %s</span>\n" "$color" "$icon" "$capacity%"
fi

# Under ablocks, while discharging: at or below $warn_capacity the critical
# icon blinks for as long as it stays there ("batcrit"); up to
# $alert_capacity a red battery fills up every 30s ("lowbat"). Guarded
# because i3blocks would show the line as the block's short text, and an if
# rather than && so a false test is not the script's exit status.
# The moment the charger goes in (Charging, Full or "Not charging" after
# Discharging) the battery fills and the bolt pulses in purple, once
# ("plugin"); the moment it comes out, the bolt fades away ("unplug"),
# ahead of any low-battery animation, which follows on the next run.
# powerupdate refreshes this block on the udev event, so both play as the
# plug moves rather than on the next 5s run. Both show the percentage even
# when the block hides it, so plugging in or out tells the level.
if [ -n "$ABLOCKS" ]; then
    if [ "$status" = "Discharging" ]; then
        if [ -n "$prev_status" ] && [ "$prev_status" != "Discharging" ]; then
            echo "@unplug 0 $capacity%"
        elif [ "$capacity" -le "$warn_capacity" ]; then
            echo "@batcrit 0 $capacity%"
        elif [ "$capacity" -le "$alert_capacity" ]; then
            echo "@lowbat 0 $capacity%"
        fi
    elif [ "$prev_status" = "Discharging" ]; then
        echo "@plugin 0 $capacity%"
    fi
fi
