#!/usr/bin/env sh
# Give a battery name (e.g. BAT0) as an argument.

case $BLOCK_BUTTON in
    3) pgrep -x dunst >/dev/null && notify-send "🔋 Battery module" ": discharging
: not charging
: stagnant charge
: charging
: charged
❗: battery very low!
- Text & icon color reflects charge left" ;;
esac

capacity=$(cat /sys/class/power_supply/"$1"/capacity) || exit
status=$(cat /sys/class/power_supply/"$1"/status)

if [ "$capacity" -ge 90 ]; then
	color="#00ff08"
	baticon="󰂂"
	chicon="󰂋"
elif [ "$capacity" -ge 70 ]; then
	color="#00ff62"
	baticon="󰂀"
	chicon="󰢞"
elif [ "$capacity" -ge 50 ]; then
	color="#d4ff00"
	baticon="󰁾"
	chicon="󰢝"
elif [ "$capacity" -ge 30 ]; then
	color="#ff7300"
	baticon="󰁼"
	chicon="󰂇"
elif [ "$capacity" -ge 20 ]; then
	color="#990000"
	baticon="󰁻"
	chicon="󰂆"
else
	color="#ff0000"
	warn="❗󰢟"
fi

[ -z $warn ] && warn=" "

[ "$status" = "Charging" ] && color="#6666ff"

printf "<span color='%s'>%s%s%s</span>\n" "$color" "$(echo "$status" | sed -e "s/,//;s/Discharging/$baticon/;s/Not Charging/󰂌/;s/Charging/$chicon/;s/Unknown/󰂑/;s/Full/󰂅/;s/ 0*/ /g;s/ :/ /g")" "$warn" "$(echo "$capacity" | sed -e 's/$/%/')"
