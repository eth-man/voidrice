#!/usr/bin/env sh

case $BLOCK_BUTTON in
	1) $TERMINAL -e nmtui ;;
	3) pgrep -x dunst >/dev/null && notify-send "🌐 Internet module" "\- Click to connect
睊 : no wifi connection
  : wifi connection with quality
  : no ethernet
  : ethernet working
" ;;
esac

case "$(cat /sys/class/net/w*/operstate 2>/dev/null)" in
	down) wificon="睊" && wificolor="#969993";;
	up) wificon="$(awk '/^\s*w/ { print "", int($3 * 100 / 70) "% " }' /proc/net/wireless)" && wificolor="#ffffff"
esac

case "$(cat /sys/class/net/e*/operstate 2>/dev/null)" in
	down) lanicon="" && lancolor="#969993";;
	up) lanicon="" && lancolor="#ffffff" ;;
esac


[ -n "$wificon" ] && printf "<span color='%s'>%s</span>" "$wificolor" "$wificon"
[ -n "$lanicon" ] && printf "<span color='%s'>%s</span>" "$lancolor" "$lanicon"

printf "\n"
