#!/usr/bin/env sh

case $BLOCK_BUTTON in
	1) $TERMINAL -e nmtui ;;
	2) pgrep -x dunst >/dev/null && notify-send "Your Connection Strength:" $(grep "^\s*w" /proc/net/wireless | awk '{print int($3 * 100 / 70)"%"}') ;;
	3) pgrep -x dunst >/dev/null && notify-send " Internet module" "\- Click to connect
: wifi darker color = greater signal
: no Internet
 : ethernet
" ;;
esac

signal=$(grep "^\s*w" /proc/net/wireless | awk '{ print int($3 * 100 / 70)}')


if [ $(grep up /sys/class/net/e*/operstate)  ]; then
wifiicon="<span color='#90EE90'></span>";
elif [ "$(cat /sys/class/net/w*/operstate)" = "up" ]; then
    [ $signal -gt 25 ] && wifiicon="<span color='#83a598'></span>"
    [ $signal -gt 50 ] && wifiicon="<span color='#458588'></span>"
    [ $signal -gt 75 ] && wifiicon="<span color='#076678'></span>"
else
wifiicon="<span color='#969993'></span>";
fi



printf "%s\n" "$wifiicon"
