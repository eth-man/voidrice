#!/usr/bin/env sh
. "$HOME/.local/bin/statusbar/sb-theme"

# present: the wifi strength shows as the icon's arcs alone, no percentage
nopercent="$HOME/.local/share/sb-internet.nopercent"

case $BLOCK_BUTTON in
	# In the background, so the block can answer the click with an animation
	# now rather than after nmtui closes. Its stdout must not be the block's,
	# or the bar would wait on the terminal all the same.
	1) setsid -f "$TERMINAL" -e nmtui >/dev/null 2>&1 ;;
	2) if [ -e "$nopercent" ]; then rm -f "$nopercent"; else : > "$nopercent"; fi ;;
	3) pgrep -x dunst >/dev/null && notify-send "􀀐 Internet module" "\\- Click to connect
- Middle click shows or hides the wifi percentage
􀀑 : no wifi
􀀐 : wifi; the lit arcs give the signal, faint ones are missing
􀀝 : ethernet
Grey means the link is down.
" ;;
esac

case "$(cat /sys/class/net/w*/operstate 2>/dev/null)" in
	down) wificon="􀀑" && wificolor="$C_DIM";;
	up)
		pct=$(awk '/^\s*w/ { print int($3 * 100 / 70) }' /proc/net/wireless)
		pct=${pct:-0}
		# the arcs the signal earns, the ones it doesn't faint under them:
		# wifi-unlit-N (U+10005C..) has no width and draws beneath wifi-N
		if [ "$pct" -ge 75 ]; then wificon="􀀐"
		elif [ "$pct" -ge 50 ]; then wificon="<span alpha='25%'>􀁞</span>􀀏"
		elif [ "$pct" -ge 25 ]; then wificon="<span alpha='25%'>􀁝</span>􀀎"
		else wificon="<span alpha='25%'>􀁜</span>􀀍"
		fi
		wificolor="$C_NORM"
		[ -e "$nopercent" ] || wifipct=" $pct%"
esac

case "$(cat /sys/class/net/e*/operstate 2>/dev/null)" in
	down) lanicon="" && lancolor="$C_DIM";;
	up) lanicon="􀀝" && lancolor="$C_NORM" ;;
esac


[ -n "$lanicon" ] && lan="$(printf "<span color='%s'>%s</span>" "$lancolor" "$lanicon")"

[ -n "$wificon" ] && printf "<span color='%s'>%s%s</span>" "$wificolor" "$wificon" "$wifipct"
printf "%s\n" "$lan"

# Under ablocks, animate the wifi icon when its state changes: the bars
# drain on a disconnect, and keep doing so every 30s while the LAN is down
# too, i.e. while offline; they fill once on a reconnect. The LAN icon is
# the argument so it stays on screen through the animation. vpnupdate
# signals this block on every link change, so it lands within a second.
if [ -n "$ABLOCKS" ]; then
	state="${XDG_RUNTIME_DIR:-/tmp}/sb-internet.wifi"
	wifi="$(cat /sys/class/net/w*/operstate 2>/dev/null)"
	last="$(cat "$state" 2>/dev/null)"
	# Not "dormant", which a reconnect passes through while associating:
	# recorded, it would hide the down -> up change this is looking for.
	case "$wifi" in up|down) echo "$wifi" > "$state" ;; esac
	if [ "$BLOCK_BUTTON" = 1 ]; then
		# The bars sweep as if scanning. Everything after the icon is passed
		# exactly as printed above, so only the icon moves.
		if [ -n "$wifipct" ]; then
			echo "@wifiscan 0 <span color='$wificolor'>$wifipct</span>$lan"
		else
			echo "@wifiscan 0 $lan"
		fi
	elif [ "$wifi" = down ] && { [ "$last" = up ] || [ "$lancolor" != "$C_NORM" ]; }; then
		echo "@wifidown 0 $lan"
	elif [ "$wifi" = up ] && [ "$last" = down ]; then
		# Everything after the icon, so the animation's last frame is the
		# block's real output and the strength counts up into place.
		if [ -n "$wifipct" ]; then
			echo "@wifiup 0 ${wifipct# }$lan"
		else
			echo "@wifiupicon 0 $lan"
		fi
	fi
fi
