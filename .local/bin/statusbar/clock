#!/usr/bin/env sh
. "$HOME/.local/bin/statusbar/sb-theme"

# Shows the date as a number plate, the day of the week as
# its place in the week (today the tall bar; the week starts on Monday, or
# on the day 1-7 named in ~/.local/share/weekstart) and the time, the time
# in bold. Under ablocks, digits that change roll down like an old flip
# clock: the old ones drop out, the new ones fall in from above.

# 0 hides the day of the week, leaving the date and the time
showweek=1

# the first day of the week, 1 = Monday .. 7 = Sunday
first=$(cat "$HOME/.local/share/weekstart" 2>/dev/null)
case $first in [1-7]) ;; *) first=1 ;; esac

# The month for the notification: the day names dim, today on a soft
# tile like the bar's focused workspace, then the next three days of
# appointments, if there are any. cal can start a week only on Sunday
# or Monday, so any other first day shows from Monday.
month() {
	if [ "$first" = 7 ]; then cal -s; else cal -m; fi | sed '1d; /^ *$/d' |
		sed "1s|.*|<span color='$C_DIM'>&</span>|
			2,\$ s@\(^\| \)\($(date +%-d)\)\( \|\$\)@\1<span background='#2e3440' weight='bold'>\2</span>\3@"
	appts=$(calcurse -D ~/.config/calcurse -d3 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g')
	[ -n "$appts" ] && printf '\n\n%s' "$appts"
}

case $BLOCK_BUTTON in
	1) pgrep -x dunst >/dev/null && notify-send -h string:x-dunst-stack-tag:clock "$(date '+%B %Y')" "$(month)" ;;
	2) $TERMINAL -e calcurse -D ~/.config/calcurse ;;
	3) pgrep -x dunst >/dev/null && notify-send "Time/date module" "\- The tall bar after the date is today's place in the week.
- Left click shows the next three days of appointments and the month.
- Middle click opens calcurse." ;;
esac

# pick N ITEM...: the Nth item
pick() { shift "$1"; printf %s "$1" ;}

# one date call, so the date and the time can't straddle midnight
IFS=\| read -r month mday weekday time <<EOF
$(date '+%-m|%-d|%u|%H:%M')
EOF
# The date as a number plate: suckless icons month-1 (January) ..
# month-12 from U+100045 open the plate, plate-0 .. plate-9 from U+100051
# carry the day's digits and plate-end (U+10005B) closes it.
day=$(pick "$month" 􀁅 􀁆 􀁇 􀁈 􀁉 􀁊 􀁋 􀁌 􀁍 􀁎 􀁏 􀁐)
while [ -n "$mday" ]; do
	rest=${mday#?}
	day=$day$(pick $((${mday%"$rest"} + 1)) 􀁑 􀁒 􀁓 􀁔 􀁕 􀁖 􀁗 􀁘 􀁙 􀁚)
	mday=$rest
done
day=$day􀁛
date=$day
if [ "$showweek" = 1 ]; then
	# suckless icons week-1 (the first day) .. week-7, U+10003E onwards
	date="$date $(pick $(((weekday - first + 7) % 7 + 1)) 􀀾 􀀿 􀁀 􀁁 􀁂 􀁃 􀁄)"
fi

sb "$C_NORM" "$date <b>$time</b>"

[ -n "$ABLOCKS" ] || exit 0

# the time the last run showed; a different one now means a digit flipped
state="${XDG_RUNTIME_DIR:-/tmp}/clock-time"
prev=$(cat "$state" 2>/dev/null)
[ "$prev" = "$time" ] && exit 0
echo "$time" > "$state"
[ ${#prev} -eq ${#time} ] || exit 0

# split off the digits both times share; only the rest rolls
same= old=$prev new=$time
while [ "${old%"${old#?}"}" = "${new%"${new#?}"}" ]; do
	same=$same${new%"${new#?}"}
	old=${old#?} new=${new#?}
done
printf '@clockflip 0 %s\t%s\t%s\t%s\t%s\n' "$C_NORM" "$date " "$same" "$old" "$new"
