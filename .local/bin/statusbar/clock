#!/usr/bin/env sh
. "$HOME/.local/bin/statusbar/sb-theme"

case $BLOCK_BUTTON in
	1) pgrep -x dunst >/dev/null && notify-send "This Month" "$(cal --color=always | sed "s/..7m/<b><span color=\"red\">/;s/..27m/<\/span><\/b>/")" && notify-send "Appointments" "$(calcurse -D ~/.config/calcurse -d3)" ;;
	2) $TERMINAL -e calcurse -D ~/.config/calcurse ;;
	3) pgrep -x dunst >/dev/null && notify-send "󰥔 Time/date module" "\- Left click shows the next three days of appointments and the month.
- Middle click opens calcurse." ;;
esac

sb "$C_NORM" "󰥔 $(date '+%b %d (%a) %H:%M')"
