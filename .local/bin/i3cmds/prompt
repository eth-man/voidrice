#!/usr/bin/env sh
# A dmenu binary prompt script.
# Gives a dmenu prompt labeled with $1 to perform command $2.
# For example:
# `./prompt "Do you want to shutdown?" "shutdown -h now"`
#
# Drawn in the palette's alert red, since everything it asks about is drastic.

. "${XDG_CONFIG_HOME:-$HOME/.config}/theme/palette"

[ "$(printf "No\\nYes" | dmenu -i -p "$1" -nb "$C_PANEL" -nf "$C_DIM" -sb "$C_ALERT" -sf "$C_BRIGHT")" = "Yes" ] && $2
