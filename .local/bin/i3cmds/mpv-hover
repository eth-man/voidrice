#!/usr/bin/env sh
# run mpv in hover mode
# this require mpvSockets and proper i3 config

vid=$1


if ! pgrep -x "mpv" > /dev/null
then
    echo "not running, starting mpv.."
 notify-send " MPV Hover" "Starting Video.." && mpv "$vid" --ytdl-format="bestvideo[height<=?720]+bestaudio/best" --title="mpvhover" || notify-send " MPV Hover" "Failed to execute video.."
else
	 mpvpid=$(pidof mpv)
	 socname="/tmp/mpvSockets/$mpvpid"

        notify-send " MPV Hover" "mpv is running"
	echo loadfile "$vid" append-play | socat - "$socname";
#
echo '{"command":["show-text"," Video appended to playlist"]}' | socat - "$socname" && notify-send " MPV Hover" "Video appended to playlist" || notify-send " MPV Hover" "Failed to append video..";
fi
