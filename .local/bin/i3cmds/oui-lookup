#!/usr/bin/env sh
#
# Runs a MAC address against the IEEE OUI list to return the device vendor.
# Used by the `cabl` clipboard plumber.
#
# Usage:
# > oui-lookup 64:01:3c:08:c6:b5
#
# The vendor database is cached locally: it is 2.2MB and was previously
# re-downloaded on every single lookup. Note the `release-4.0` pin is
# load-bearing -- newer wireshark branches no longer publish `manuf`.

db="${XDG_DATA_HOME:-$HOME/.local/share}/manuf"
url="https://raw.githubusercontent.com/wireshark/wireshark/release-4.0/manuf"

[ -z "$1" ] && echo "usage: oui-lookup <mac>" >&2 && exit 1

# Normalise to Unix notation and keep the 3-byte OUI prefix.
mac="$(echo "$1" | tr '[:lower:]' '[:upper:]' |
	sed 's![-.:]!!g;s!\(..\)!\1:!g;s!:$!!' | cut -c-8)"

# Refresh the cache if absent or older than 30 days.
if [ ! -s "$db" ] || [ -n "$(find "$db" -mtime +30 2>/dev/null)" ]; then
	notify-send -u low "󰇚 Fetching MAC vendor database..."
	mkdir -p "$(dirname "$db")"
	curl -sf --max-time 60 "$url" -o "$db.part" && mv -f "$db.part" "$db" || {
		rm -f "$db.part"
		[ -s "$db" ] || { notify-send "Could not download the OUI database."; exit 1 ;}
	}
fi

oui="$(grep -i "^$mac" "$db" | head -n 1)"

if [ -n "$oui" ]; then
	notify-send -t 15000 "Vendor details: $oui"
else
	notify-send "can't find mac vendor"
fi
