.mozilla/
.config/chromium/
.config/google-chrome/
.config/BraveSoftware/
.config/opera/
.config/vivaldi/

# --- Agent / tooling state --------------------------------------------------
.claude/
.claude.json*
.config/gh/
.npmrc
.pypirc
.git-credentials

